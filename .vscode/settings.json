{
  "files.exclude": {
    "**/*.pytest_cache": true,
    "**/*.ruff_cache": true,
    "**/*.egg-info": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/wandb": true,
    ".coverage": true,
    "**/.gitattributes": true,
    "**/repomix.config.json": true,
    "**/LICENSE": true,
    "pytest.ini": true,
    ".prettierrc": true,
    ".envrc": true,
    ".gitignore": true,
    "environment.yml": true,
    "pyproject.toml": true,
    "requirements.txt": true,
    "uv.lock": true,
    ".pre-commit-config.yaml": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  }
}
